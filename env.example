# --- PICO 4 Enterprise (phoenix_enterprise): python -m overpressure --device phoenix_enterprise ... ---

# Serials: "adb devices", "fastboot devices", and "Serial Number" in edl-ng's output.
PHOENIX_ENTERPRISE_ADB_SERIAL=
PHOENIX_ENTERPRISE_FASTBOOT_SERIAL=
PHOENIX_ENTERPRISE_EDL_SERIAL=

# The headset's records: its identity and its verified EDL backup.
PHOENIX_ENTERPRISE_IDENTITY=backup/device.json
PHOENIX_ENTERPRISE_BACKUP=backup/stock

# The Firehose loader for EDL. Empty PHOENIX_ENTERPRISE_EDL: the edl-ng that python -m overpressure tools fetches.
PHOENIX_ENTERPRISE_LOADER=assets/firehose.elf
PHOENIX_ENTERPRISE_EDL=

# Your own public key file, enrolled besides this computer's key where the headset takes SSH keys.
PHOENIX_ENTERPRISE_SSH_PUBLIC_KEY=

# Windows: a Python with pyusb and libusb-package for a USB network link. Empty: the Python that runs overpressure.
PHOENIX_ENTERPRISE_NCM_PYTHON=

# Programs: your own adb and fastboot folder (empty: the platform-tools python -m overpressure tools fetches,
# else PATH), ssh and ssh-keygen.
PHOENIX_ENTERPRISE_PLATFORM_TOOLS=
PHOENIX_ENTERPRISE_SSH=ssh
PHOENIX_ENTERPRISE_SSH_KEYGEN=ssh-keygen
